# Imagery and intermediate arrays -- never version these
*.tif
*.tiff
*.jp2
*.npy
*.npz
*.SAFE/

# Model weights
*.pt
*.pth
*.ckpt
*.onnx
checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Credentials. kaggle.json normally lives in ~/.kaggle/, outside the repo, but a
# copy dropped in here would be an API key published to GitHub. Ignored
# everywhere, unconditionally.
kaggle.json
**/kaggle.json
.kaggle/

# Run artefacts -- ignore the contents, keep the directory skeleton.
# This block is last on purpose: the negations must win over `checkpoints/` above.
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Downloaded Kaggle run trees, and generated kernel build folders.
#
# These need their own rule even though `outputs/**` already ignores file
# contents. The `!outputs/**/` negation above deliberately un-ignores every
# DIRECTORY under outputs/ to keep the skeleton in the repo -- and a kernel
# output downloaded by scripts/kaggle_run.py can contain a full clone of this
# repository, .git included. Git adds such a directory as an embedded gitlink
# regardless of the file-level ignore, which is how one reached a commit on
# 2026-09-06. Generated notebooks land here too and are build artefacts.
outputs/kaggle/
outputs/kaggle_kernels/
# Raw `kaggle kernels output` downloads. The run files are tracked under runs/day3/
# (verified byte-identical 2026-09-11); this tree also carries a repo clone.
runs/kaggle/

# Real Sentinel-2 scenes over Delhi NCR, fetched by scripts/fetch_delhi.py.
# Imagery plus its manifest. The *.tif rule at the top of this file already
# covers the rasters; this rule also covers manifest.json, which names the exact
# STAC items and so makes the directory reproducible without versioning pixels.
data/delhi/
